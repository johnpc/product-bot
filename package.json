{
  "name": "jpc-product-bot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sandbox": "ampx sandbox --profile personal",
    "prepare": "husky install",
    "uploadCsvFile": "aws s3 --profile personal cp $CSV_PATH s3://$(cat amplify_outputs.json | jq -r .storage.bucket_name)/csvs/products.csv",
    "uploadCsv": "CSV_PATH=large-file.csv npm run uploadCsvFile"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.8.0",
    "@aws-amplify/ui-react-ai": "^1.2.0",
    "aws-amplify": "^6.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.11.0",
    "@aws-amplify/backend-cli": "^1.4.5",
    "@aws-sdk/client-bedrock-runtime": "^3.716.0",
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "aws-cdk": "^2.159.1",
    "aws-cdk-lib": "^2.159.1",
    "constructs": "^10.3.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.2.10",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  },
  "lint-staged": {
    "*.ts": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.json": "prettier --write",
    "*.yml": "prettier --write",
    "*.md": "prettier --write"
  }
}
